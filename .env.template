# All ports
LANGFUSE_PORT=3000
LITELLM_PORT=4000
REDIS_URL="redis://langfuse-redis:6379"
MINIO_URL="http://langfuse-minio:9000"

# Database Credentials
POSTGRES_USER=CHANGE-USERNAME
POSTGRES_PASSWORD=CHANGE-PASSWORD
POSTGRES_DB=litellm_production

# Storage Paths
PGDATA_PATH=/var/lib/postgresql/data
HF_HOME_PATH=$HOME/.cache/huggingface
# Optional Hugging Face access token for private or gated models
HF_TOKEN=hf_COPY-FROM-HUGGING-FACE

# Inference engine: vllm (default) or tgi
INFERENCE_ENGINE=vllm
TGI_IMAGE=ghcr.io/huggingface/text-generation-inference:3.3.5

# Inference engine: vllm (default) or tgi
INFERENCE_ENGINE=vllm
TGI_IMAGE=ghcr.io/huggingface/text-generation-inference:3.3.5

# LiteLLM Admin & UI Credentials (NEW)
# openssl rand -hex 32
LITELLM_MASTER_KEY=sk-master-AAAAAAA8GenerateYourOwnKey
UI_USERNAME=admin
UI_PASSWORD=CHANGE-PASSWORD
STORE_MODEL_IN_DB=True

# Optional: Directly set DATABASE_URL or let Python build it dynamically
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"

# Optional Explicit Override for vLLM Image
VLLM_IMAGE_OVERRIDE="vllm/vllm-openai:v0.15.0"

# vLLM tensor parallelism; each model may override this with tensor_parallel_size in models.json
TENSOR_PARALLEL_SIZE=1

# LiteLLM budgets, fallback routing, and tracing
LITELLM_MAX_BUDGET=20
LITELLM_DEFAULT_KEY_MAX_BUDGET=20
LITELLM_BUDGET_DURATION=1mo
LITELLM_FALLBACK_MODEL=
LITELLM_CALLBACKS=langfuse
LANGFUSE_ENABLED=true
LANGFUSE_HOST="http://langfuse:${LANGFUSE_PORT}"
