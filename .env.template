POSTGRES_PASSWORD=CHANGE-PASSWORD
POSTGRES_DB=litellm_production

# Storage Paths
PGDATA_PATH=/var/lib/postgresql/data
HF_HOME_PATH=$HOME/.cache/huggingface
# Optional Hugging Face access token for private or gated models
HF_TOKEN=hf_COPY-FROM-HUGGING-FACE

# Inference engine: vllm (default) or tgi
INFERENCE_ENGINE=vllm
TGI_IMAGE=ghcr.io/huggingface/text-generation-inference:3.3.5

# LiteLLM Admin & UI Credentials (NEW)
