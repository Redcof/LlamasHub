# Database Credentials
POSTGRES_USER=litellm_admin
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=litellm_production

# Storage Paths
PGDATA_PATH=/var/lib/postgresql/data
HF_HOME_PATH=/home/ubuntu/.cache/huggingface

# LiteLLM Admin & UI Credentials (NEW)
LITELLM_MASTER_KEY=sk-master-key-change-this-secret
UI_USERNAME=admin
UI_PASSWORD=change-this-admin-password

# Optional: Directly set DATABASE_URL or let Python build it dynamically
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"

# Optional Explicit Override for vLLM Image
VLLM_IMAGE_OVERRIDE="vllm/vllm-openai:v0.11.0"

# vLLM tensor parallelism; each model may override this with tensor_parallel_size in models.json
TENSOR_PARALLEL_SIZE=1

# LiteLLM budgets, fallback routing, and tracing
LITELLM_MAX_BUDGET=20
LITELLM_DEFAULT_KEY_MAX_BUDGET=20
LITELLM_BUDGET_DURATION=1mo
LITELLM_FALLBACK_MODEL=
LITELLM_CALLBACKS=langfuse
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lh-local
LANGFUSE_SECRET_KEY=sk-lh-local
LANGFUSE_NEXTAUTH_SECRET=change-this-nextauth-secret
LANGFUSE_SALT=change-this-salt
LANGFUSE_ENCRYPTION_KEY=change-this-encryption-key-32-chars
LANGFUSE_S3_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_SECRET_ACCESS_KEY=change-this-minio-secret

# Nginx public boundary. Replace hostnames and mount an internal-CA certificate pair.
API_HOSTNAME=api.example.internal
OBSERVABILITY_HOSTNAME=observability.example.internal
NGINX_TLS_CERTIFICATE=./certs/server.crt
NGINX_TLS_CERTIFICATE_KEY=./certs/server.key
NGINX_ENABLED=true
