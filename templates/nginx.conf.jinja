events {}

http {
    upstream litellm {
        server litellm:4000;
    }
{% if langfuse_enabled %}
    upstream langfuse {
        server langfuse:3000;
    }
{% endif %}

    server {
        listen 80;
        server_name {{ api_hostname }}{% if langfuse_enabled %} {{ observability_hostname }}{% endif %};
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name {{ api_hostname }};
        ssl_certificate {{ nginx_tls_certificate }};
        ssl_certificate_key {{ nginx_tls_certificate_key }};

        location = /nginx-health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'ok';
        }

        location / {
            proxy_pass http://litellm;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
{% if langfuse_enabled %}
    server {
        listen 443 ssl;
        server_name {{ observability_hostname }};
        ssl_certificate {{ nginx_tls_certificate }};
        ssl_certificate_key {{ nginx_tls_certificate_key }};

        location / {
            proxy_pass http://langfuse;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
{% endif %}
}
