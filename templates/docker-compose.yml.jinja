services:
  db:
    image: {{ postgres_image }}
    restart: always
    environment:
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_pass }}
      POSTGRES_DB: {{ db_name }}
    volumes:
      - pgdata:{{ pgdata_path }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }}"]
      interval: 15s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"

{% for m in active_models %}
  {{ inference_engine }}-{{ m.id }}:
    image: {{ m.image }}
    restart: always
    ports:
      - "{{ m.port }}:{{ m.port }}"
    environment:
      - CUDA_VISIBLE_DEVICES={% for gpu_id in range(m.gpu_id, m.gpu_id + (m.tensor_parallel_size | default(1))) %}{{ gpu_id }}{% if not loop.last %},{% endif %}{% endfor %}
      - HF_TOKEN
      - VLLM_ENABLE_CUDA_COMPATIBILITY=1
    volumes:
      - {{ hf_home_path }}:/root/.cache/huggingface
    ipc: host
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: [{% for gpu_id in range(m.gpu_id, m.gpu_id + (m.tensor_parallel_size | default(1))) %}'{{ gpu_id }}'{% if not loop.last %}, {% endif %}{% endfor %}]
              capabilities: [gpu]
    command: >
    {% if inference_engine == "tgi" %}
      --model-id {{ m.hf_repo }}
      --port {{ m.port }}
      --max-total-tokens {{ m.max_model_len }}
      --num-shard {{ m.tensor_parallel_size | default(1) }}
    {% else %}
      --model {{ m.hf_repo }}
      --port {{ m.port }}
      --gpu-memory-utilization 0.85
      --max-model-len {{ m.max_model_len }}
      --tensor-parallel-size {{ m.tensor_parallel_size | default(1) }}
    {% endif %}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ m.port }}/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 100
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"

{% endfor %}
{% if langfuse_enabled %}
  langfuse-clickhouse:
    image: {{ clickhouse_image }}
    restart: always
    environment:
      CLICKHOUSE_DB: default
      CLICKHOUSE_USER: clickhouse
      CLICKHOUSE_PASSWORD: clickhouse
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    volumes:
      - langfuse-clickhouse-data:/var/lib/clickhouse
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://127.0.0.1:8123/ping | grep Ok"]
      interval: 15s
      timeout: 5s
      retries: 10
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"


  langfuse-redis:
    image: {{ redis_image }}
    restart: always
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"


  langfuse-minio:
    image: {{ minio_image }}
    restart: always
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: {{ langfuse_minio_access_key }}
      MINIO_ROOT_PASSWORD: {{ langfuse_minio_secret_key }}
    volumes:
      - langfuse-minio-data:/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9000/minio/health/live || exit 1"]
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"


  langfuse:
    image: {{ langfuse_image }}
    restart: always
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: {{ langfuse_database_url }}
      NEXTAUTH_URL: http://localhost:3000
      NEXTAUTH_SECRET: {{ langfuse_nextauth_secret }}
      SALT: {{ langfuse_salt }}
      ENCRYPTION_KEY: {{ langfuse_encryption_key }}
      TELEMETRY_ENABLED: "false"
      CLICKHOUSE_MIGRATION_URL: clickhouse://clickhouse:clickhouse@langfuse-clickhouse:9000/default
      CLICKHOUSE_URL: http://langfuse-clickhouse:8123
      CLICKHOUSE_USER: clickhouse
      CLICKHOUSE_PASSWORD: clickhouse
      REDIS_CONNECTION_STRING: redis://langfuse-redis:6379
      S3_EVENT_UPLOAD_BUCKET: langfuse
      S3_EVENT_UPLOAD_REGION: us-east-1
      S3_EVENT_UPLOAD_ACCESS_KEY_ID: {{ langfuse_minio_access_key }}
      S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: {{ langfuse_minio_secret_key }}
      S3_EVENT_UPLOAD_ENDPOINT: http://langfuse-minio:9000
      S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      LANGFUSE_INIT_PROJECT_PUBLIC_KEY: {{ langfuse_public_key }}
      LANGFUSE_INIT_PROJECT_SECRET_KEY: {{ langfuse_secret_key }}
      LANGFUSE_INIT_ORG_ID: smiths-detection-ai
      LANGFUSE_INIT_ORG_NAME: Smiths Detection AI
      LANGFUSE_INIT_PROJECT_ID: llamashub
      LANGFUSE_INIT_PROJECT_NAME: Llamashub
      LANGFUSE_INIT_USER_EMAIL: soumen.sardar@smithsdetection.com
      LANGFUSE_INIT_USER_NAME: admin
      LANGFUSE_INIT_USER_PASSWORD: admin-pool
      LANGFUSE_MARKDOWN_RENDER_CHARACTER_LIMIT: 50000
      LANGFUSE_MCP_ALLOWED_HOSTS: localhost,127.0.0.1
      LANGFUSE_IN_APP_AGENT_MAX_ACTIVE_RUNS_PER_USER: 10
      LANGFUSE_IN_APP_AGENT_MAX_ACTIVE_RUNS_PER_ORG: 100
    depends_on:
      db:
        condition: service_healthy
      langfuse-clickhouse:
        condition: service_healthy
      langfuse-redis:
        condition: service_healthy
      langfuse-minio:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://$(hostname -i):3000/api/public/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"
{% endif %}

{% if nginx_enabled %}
  nginx:
    image: {{ nginx_image }}
    restart: always
    ports:
      - "80:80"
      - "443:443"
      - "4000:4000"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ nginx_tls_certificate }}:/etc/nginx/tls/server.crt:ro
      - {{ nginx_tls_certificate_key }}:/etc/nginx/tls/server.key:ro
    depends_on:
      - litellm
{% if langfuse_enabled %}
      - langfuse
{% endif %}
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 15s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"
    {% endif %}

  litellm:
    image: {{ litellm_image }}
    restart: always
    ports:
      - "4000:4000"
    environment:
      - DATABASE_URL={{ db_url }}
      - LITELLM_MASTER_KEY={{ litellm_master_key }}
      - UI_USERNAME={{ ui_username }}
      - UI_PASSWORD={{ ui_password }}
      - REDIS_URL=redis://langfuse-redis:6379
{% if nginx_enabled and langfuse_enabled %}
      - LANGFUSE_HOST={{ langfuse_host }}
{% endif %}
    volumes:
      - ./litellm_config.yaml:/app/config.yaml
    env_file:
      - .env
    command: --config /app/config.yaml --port 4000
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request;urllib.request.urlopen('http://127.0.0.1:4000/health/readiness', timeout=2)"]
      interval: 15s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"
    depends_on:
      db:
        condition: service_healthy
      langfuse-redis:
        condition: service_healthy
{% for m in active_models %}
      {{ inference_engine }}-{{ m.id }}:
        condition: service_healthy
{% endfor %}
{% if langfuse_enabled %}
      langfuse:
        condition: service_healthy
{% endif %}

volumes:
  pgdata:
{% if langfuse_enabled %}
  langfuse-clickhouse-data:
  langfuse-minio-data:
{% endif %}
