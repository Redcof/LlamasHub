model_list:
{% for model in active_models %}
  - model_name: {{ model.model_name }}
    litellm_params:
      model: hosted_vllm/{{ model.hf_repo }}
      api_base: http://{{ inference_engine }}-{{ model.id }}:{{ model.port }}/v1
      max_tokens: 4096
      drop_params: true
      temperature: 0.1
      top_p: 0.85
      repetition_penalty: 1.15
      presence_penalty: 0.2
      initial_prompt_value: "BE EXTREMELY CONCISE AND DIRECT. Output only necessary code diffs or short bullet points. Avoid conversational fluff."


{% endfor %}

general_settings:
  max_budget: {{ litellm_max_budget }}
  default_key_max_budget: {{ litellm_default_key_max_budget }}
  budget_duration: {{ litellm_budget_duration }}
  redis_url: redis://langfuse-redis:6379
litellm_settings:
  set_verbose: false
  json_logs: false
{% if litellm_fallback_model %}
  fallbacks:
    - {"{{ active_models[0].model_name }}": ["{{ litellm_fallback_model }}"]}
{% endif %}
  callbacks:
{% for callback in litellm_callbacks %}
    - {{ callback }}
{% endfor %}